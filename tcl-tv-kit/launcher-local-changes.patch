diff --git a/launcher/app/src/main/java/com/gathin/tvhome/WeatherLine.java b/launcher/app/src/main/java/com/gathin/tvhome/WeatherLine.java
new file mode 100644
index 00000000..83307480
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/WeatherLine.java
@@ -0,0 +1,149 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.database.Cursor;
+import android.graphics.Color;
+import android.graphics.drawable.Drawable;
+import android.graphics.drawable.GradientDrawable;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.view.View;
+import android.widget.TextView;
+
+/**
+ * Weather and air quality under the date, read from ANOTHER app's content provider (config.xml weather_provider).
+ * The launcher itself has no internet access and still has none: a separate app (with the INTERNET permission)
+ * fetches the data and publishes one row, and this class only reads that row, locally, while Home is on screen.
+ * Same lifecycle as the optional stats line: nothing runs while Home is paused, and with no provider set (the
+ * default) the views stay gone and nothing is read.
+ *
+ * The weather symbol and the air-quality dot are drawn as drawables, not font glyphs: a glyph from a fallback font
+ * sits at its own height and pulls the line off-centre, a drawable centres exactly.
+ */
+final class WeatherLine {
+    /** A local query is cheap; the provider decides when its data is stale and refetches. */
+    private static final long RECHECK_MS = 2 * 60 * 1000L;
+    /** The first query after a long pause may only trigger the provider's fetch: ask again shortly. */
+    private static final long SOON_MS = 7000L;
+    /** Older than this and the numbers would mislead: show nothing. */
+    private static final long TOO_OLD_MS = 6 * 60 * 60 * 1000L;
+
+    private final Context ctx;
+    private final Uri uri;
+    private final View block;
+    private final TextView line1, line2;
+    private final Handler ui;
+    private final float density;
+    private HandlerThread thread;
+    private volatile Handler bg;
+
+    WeatherLine(Context ctx, String authority, View block, TextView line1, TextView line2, Handler ui) {
+        this.ctx = ctx;
+        this.uri = Uri.parse("content://" + authority + "/now");
+        this.block = block;
+        this.line1 = line1;
+        this.line2 = line2;
+        this.ui = ui;
+        this.density = ctx.getResources().getDisplayMetrics().density;
+    }
+
+    void start() {
+        if (thread != null) return;
+        thread = new HandlerThread("weather");
+        thread.start();
+        // Each start has its own handler, held by its task, so stop() can clear the field at any moment.
+        Handler h = new Handler(thread.getLooper());
+        bg = h;
+        h.post(new Runnable() {
+            @Override
+            public void run() {
+                if (bg != h) return;
+                boolean got = readOnce(h);
+                if (bg == h) h.postDelayed(this, got ? RECHECK_MS : SOON_MS);
+            }
+        });
+    }
+
+    void stop() {
+        if (thread == null) return;
+        bg.removeCallbacksAndMessages(null);
+        thread.quit();
+        thread = null;
+        bg = null;
+        // The last answer stays on screen while an app is on top, like the stats line.
+    }
+
+    /** Runs off the main thread. True when a fresh enough row was shown. */
+    private boolean readOnce(Handler me) {
+        boolean got = false;
+        int temp = 0, aqi = -1;
+        String symbol = "";
+        try (Cursor c = ctx.getContentResolver().query(uri, null, null, null, null)) {
+            if (c != null && c.moveToFirst()) {
+                long updated = c.getLong(c.getColumnIndexOrThrow("updated"));
+                if (System.currentTimeMillis() - updated < TOO_OLD_MS) {
+                    temp = c.getInt(c.getColumnIndexOrThrow("temp"));
+                    aqi = c.getInt(c.getColumnIndexOrThrow("aqi"));
+                    symbol = c.getString(c.getColumnIndexOrThrow("symbol"));
+                    got = true;
+                }
+            }
+        } catch (RuntimeException e) {
+            // The feed app is not installed, not allowed to start, or answered something else: show nothing.
+        }
+        boolean show = got;
+        int t = temp, a = aqi;
+        String sym = symbol;
+        ui.post(() -> {
+            if (bg != me) return;
+            if (!show) {
+                block.setVisibility(View.GONE);
+                return;
+            }
+            block.setVisibility(View.VISIBLE);
+            line1.setText(t + "°");
+            line1.setCompoundDrawablesRelativeWithIntrinsicBounds(symbolDrawable(sym), null, null, null);
+            boolean air = a >= 0;
+            line2.setVisibility(air ? View.VISIBLE : View.GONE);
+            View divider = block.findViewById(R.id.weatherDivider);
+            if (divider != null) divider.setVisibility(air ? View.VISIBLE : View.GONE);
+            if (air) {
+                line2.setText("AQI " + a);
+                line2.setCompoundDrawablesRelativeWithIntrinsicBounds(dot(a), null, null, null);
+            }
+        });
+        return got;
+    }
+
+    /** The provider's one-character weather symbol as a white drawable (1 dp of padding is set in the layout). */
+    private Drawable symbolDrawable(String symbol) {
+        int res;
+        if ("☀".equals(symbol)) res = R.drawable.ic_weather_sun;
+        else if ("☾".equals(symbol)) res = R.drawable.ic_weather_moon;
+        else if ("❄".equals(symbol)) res = R.drawable.ic_weather_snow;
+        else if ("ϟ".equals(symbol)) res = R.drawable.ic_weather_bolt;
+        else if ("☂".equals(symbol)) res = R.drawable.ic_weather_rain;
+        else res = R.drawable.ic_weather_cloud;
+        return ctx.getDrawable(res);
+    }
+
+    /** A small dot in the US EPA colour of the band. */
+    private Drawable dot(int aqi) {
+        GradientDrawable d = new GradientDrawable();
+        d.setShape(GradientDrawable.OVAL);
+        d.setColor(bandColor(aqi));
+        int size = Math.round(7 * density);
+        d.setSize(size, size);
+        return d;
+    }
+
+    private static int bandColor(int aqi) {
+        if (aqi <= 50) return Color.parseColor("#3FD16B");
+        if (aqi <= 100) return Color.parseColor("#FFD60A");
+        if (aqi <= 150) return Color.parseColor("#FF9F0A");
+        if (aqi <= 200) return Color.parseColor("#FF453A");
+        if (aqi <= 300) return Color.parseColor("#BF5AF2");
+        return Color.parseColor("#C0394F");
+    }
+}
