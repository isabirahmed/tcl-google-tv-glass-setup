index 00000000..f19f837b
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/GlassBackdrop.java
@@ -0,0 +1,199 @@
+package com.gathin.tvhome;
+
+import android.graphics.Bitmap;
+import android.graphics.BitmapShader;
+import android.graphics.Canvas;
+import android.graphics.Matrix;
+import android.graphics.Paint;
+import android.graphics.PixelFormat;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.graphics.ColorFilter;
+import android.graphics.drawable.Drawable;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.DisplayMetrics;
+import android.view.View;
+
+import java.lang.ref.WeakReference;
+import java.util.ArrayList;
+import java.util.Iterator;
+import java.util.List;
+
+/**
+ * Frosted glass over the wallpaper, without a live blur (Android 11 has no backdrop blur API, and a GPU blur of the
+ * whole screen every frame would be too heavy for this TV). The wallpaper is blurred ONCE, at 192 x 108, when it is
+ * decoded (WallpaperPlayer); each glass surface (a tile, the weather pill, a top button) then paints the slice of that
+ * blurred copy that lies behind it, and its own light glass layer goes on top. Cost: a few milliseconds per wallpaper
+ * change and an 80 KB bitmap. With no wallpaper there is no blurred copy and the surfaces keep their plain glass.
+ */
+final class GlassBackdrop {
+    private static final int SMALL_W = 192, SMALL_H = 108;
+    /**
+     * Box-blur radius in cells of the small copy (a cell is 10 px on a 1080p screen), applied twice: a blur of about 20 px,
+     * a good tenth of a tile, so the scene's large colour shapes stay readable through the glass (soft, not mud).
+     */
+    private static final int RADIUS = 2, PASSES = 2;
+    /** Glass looks richer than what is behind it: the blurred colours are pushed this far from grey (Apple does the same). */
+    private static final float SATURATION = 1.35f;
+    private static final Handler MAIN = new Handler(Looper.getMainLooper());
+    private static final List<WeakReference<BackdropDrawable>> DRAWABLES = new ArrayList<>();
+    private static volatile Bitmap blurred;
+
+    private GlassBackdrop() {
+    }
+
+    static Bitmap get() {
+        return blurred;
+    }
+
+    /** Makes the blurred copy of a decoded (software) wallpaper, framed as the screen shows it (centre crop). */
+    static Bitmap blur(Bitmap decoded, int screenW, int screenH) {
+        try {
+            int sw = decoded.getWidth(), sh = decoded.getHeight();
+            if (sw <= 0 || sh <= 0 || screenW <= 0 || screenH <= 0) return null;
+            float scale = Math.max((float) screenW / sw, (float) screenH / sh);
+            float cw = screenW / scale, ch = screenH / scale;
+            Rect src = new Rect(Math.round((sw - cw) / 2), Math.round((sh - ch) / 2),
+                    Math.round((sw + cw) / 2), Math.round((sh + ch) / 2));
+            Paint paint = new Paint(Paint.FILTER_BITMAP_FLAG);
+            // Two bilinear steps (to 4x, then to 1x of the small size) so the picture is averaged, not sampled.
+            Bitmap mid = Bitmap.createBitmap(SMALL_W * 4, SMALL_H * 4, Bitmap.Config.ARGB_8888);
+            new Canvas(mid).drawBitmap(decoded, src, new Rect(0, 0, mid.getWidth(), mid.getHeight()), paint);
+            Bitmap small = Bitmap.createBitmap(SMALL_W, SMALL_H, Bitmap.Config.ARGB_8888);
+            new Canvas(small).drawBitmap(mid, null, new Rect(0, 0, SMALL_W, SMALL_H), paint);
+            mid.recycle();
+            int n = SMALL_W * SMALL_H;
+            int[] px = new int[n];
+            small.getPixels(px, 0, SMALL_W, 0, 0, SMALL_W, SMALL_H);
+            int[][] ch3 = new int[3][n];
+            for (int i = 0; i < n; i++) {
+                ch3[0][i] = (px[i] >> 16) & 0xFF;
+                ch3[1][i] = (px[i] >> 8) & 0xFF;
+                ch3[2][i] = px[i] & 0xFF;
+            }
+            int[] tmp = new int[n];
+            for (int c = 0; c < 3; c++) {
+                for (int p = 0; p < PASSES; p++) {
+                    box(ch3[c], tmp, SMALL_W, SMALL_H, RADIUS, true);
+                    box(tmp, ch3[c], SMALL_W, SMALL_H, RADIUS, false);
+                }
+            }
+            for (int i = 0; i < n; i++) {
+                int r = ch3[0][i], g = ch3[1][i], b = ch3[2][i];
+                float grey = 0.299f * r + 0.587f * g + 0.114f * b;
+                r = clamp(Math.round(grey + SATURATION * (r - grey)));
+                g = clamp(Math.round(grey + SATURATION * (g - grey)));
+                b = clamp(Math.round(grey + SATURATION * (b - grey)));
+                px[i] = 0xFF000000 | (r << 16) | (g << 8) | b;
+            }
+            small.setPixels(px, 0, SMALL_W, 0, 0, SMALL_W, SMALL_H);
+            return small;
+        } catch (Throwable failure) {
+            return null;
+        }
+    }
+
+    private static int clamp(int v) {
+        return v < 0 ? 0 : Math.min(v, 255);
+    }
+
+    /** One box-blur pass along a row (horizontal) or a column, edges clamped. */
+    private static void box(int[] in, int[] out, int w, int h, int r, boolean horizontal) {
+        int div = 2 * r + 1;
+        int lines = horizontal ? h : w, len = horizontal ? w : h;
+        int step = horizontal ? 1 : w, lineStep = horizontal ? w : 1;
+        for (int l = 0; l < lines; l++) {
+            int base = l * lineStep;
+            int sum = 0;
+            for (int i = -r; i <= r; i++) sum += in[base + Math.max(0, Math.min(len - 1, i)) * step];
+            for (int i = 0; i < len; i++) {
+                out[base + i * step] = sum / div;
+                sum += in[base + Math.min(len - 1, i + r + 1) * step] - in[base + Math.max(0, i - r) * step];
+            }
+        }
+    }
+
+    /** Makes a new blurred copy current and repaints every glass surface. */
+    static void publish(Bitmap b) {
+        if (b == null) return;
+        blurred = b;
+        MAIN.post(() -> {
+            synchronized (DRAWABLES) {
+                for (Iterator<WeakReference<BackdropDrawable>> it = DRAWABLES.iterator(); it.hasNext(); ) {
+                    BackdropDrawable d = it.next().get();
+                    if (d == null) it.remove();
+                    else d.invalidateSelf();
+                }
+            }
+        });
+    }
+
+    /**
+     * The slice of the blurred wallpaper behind one view, as rounded glass: radius is a fraction of the width
+     * (tiles), a fixed size in px, or both 0 for a full pill or circle (half the shorter side). Draw it as the first layer
+     * of the view's background. It repaints when the view is laid out again (it may have moved) and when the wallpaper changes.
+     */
+    static final class BackdropDrawable extends Drawable {
+        private final View host;
+        private final float radiusFraction, radiusPx;
+        private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG | Paint.FILTER_BITMAP_FLAG);
+        private final Matrix matrix = new Matrix();
+        private final RectF rect = new RectF();
+        private final int[] location = new int[2];
+        private final int screenW, screenH;
+        private Bitmap shaderBitmap;
+        private BitmapShader shader;
+
+        BackdropDrawable(View host, float radiusFraction, float radiusPx) {
+            this.host = host;
+            this.radiusFraction = radiusFraction;
+            this.radiusPx = radiusPx;
+            DisplayMetrics m = host.getResources().getDisplayMetrics();
+            screenW = m.widthPixels;
+            screenH = m.heightPixels;
+            host.addOnLayoutChangeListener((v, l, t, r, b, ol, ot, or, ob) -> invalidateSelf());
+            synchronized (DRAWABLES) {
+                DRAWABLES.add(new WeakReference<>(this));
+            }
+        }
+
+        @Override
+        public void draw(Canvas canvas) {
+            Bitmap bmp = blurred;
+            Rect bounds = getBounds();
+            if (bmp == null || bounds.isEmpty()) return;
+            if (bmp != shaderBitmap) {
+                shaderBitmap = bmp;
+                shader = new BitmapShader(bmp, Shader.TileMode.CLAMP, Shader.TileMode.CLAMP);
+                paint.setShader(shader);
+            }
+            // On screen, not in the window: a popup (the app library) is a window of its own, offset from the screen's origin.
+            host.getLocationOnScreen(location);
+            // Bitmap pixel -> screen pixel -> this view's own coordinates.
+            matrix.setScale((float) screenW / bmp.getWidth(), (float) screenH / bmp.getHeight());
+            matrix.postTranslate(-location[0], -location[1]);
+            shader.setLocalMatrix(matrix);
+            rect.set(bounds);
+            float r = radiusFraction > 0 ? radiusFraction * rect.width()
+                    : radiusPx > 0 ? radiusPx : Math.min(rect.width(), rect.height()) / 2f;
+            canvas.drawRoundRect(rect, r, r, paint);
+        }
+
+        @Override
+        public void setAlpha(int alpha) {
+            paint.setAlpha(alpha);
+        }
+
+        @Override
+        public void setColorFilter(ColorFilter colorFilter) {
+            paint.setColorFilter(colorFilter);
+        }
+
+        @Override
+        public int getOpacity() {
+            return PixelFormat.TRANSLUCENT;
+        }
+    }
+}
