--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/LiftSheen.java
@@ -0,0 +1,95 @@
+package com.gathin.tvhome;
+
+import android.animation.ValueAnimator;
+import android.graphics.Canvas;
+import android.graphics.ColorFilter;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.PixelFormat;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.graphics.drawable.Drawable;
+import android.view.animation.DecelerateInterpolator;
+
+/**
+ * The look of a focused tile (square_tiles, glass_style lift), drawn ON the tile as its foreground: a faintly brighter
+ * surface, a diagonal specular sheen from the top-left corner and an edge lit from above. It fades in as the tile gains
+ * focus and out as it loses it, so it moves with the tile (it scales and lifts with it) instead of being a separate
+ * overlay that slides between tiles. The shadow under the tile is the tile's own elevation.
+ */
+final class LiftSheen extends Drawable {
+    private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint sheen = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint rim = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF rect = new RectF();
+    private final float rimWidth;
+    /** 0 (not focused) to 255 (focused); animated. */
+    private int level;
+    private ValueAnimator animator;
+
+    LiftSheen(float density) {
+        rimWidth = 1.2f * density;
+        rim.setStyle(Paint.Style.STROKE);
+        rim.setStrokeWidth(rimWidth);
+    }
+
+    /** Fades the focus look in or out. */
+    void animateTo(int target, long durationMs) {
+        if (animator != null) animator.cancel();
+        if (durationMs <= 0) {
+            level = target;
+            invalidateSelf();
+            return;
+        }
+        animator = ValueAnimator.ofInt(level, target);
+        animator.setDuration(durationMs);
+        animator.setInterpolator(new DecelerateInterpolator());
+        animator.addUpdateListener(a -> {
+            level = (Integer) a.getAnimatedValue();
+            invalidateSelf();
+        });
+        animator.start();
+    }
+
+    @Override
+    protected void onBoundsChange(Rect b) {
+        float w = b.width(), h = b.height();
+        fill.setShader(new LinearGradient(0, 0, 0, h, 0x1CFFFFFF, 0x0AFFFFFF, Shader.TileMode.CLAMP));
+        sheen.setShader(new LinearGradient(0, 0, w * 0.85f, h * 0.85f, 0x42FFFFFF, 0x00FFFFFF, Shader.TileMode.CLAMP));
