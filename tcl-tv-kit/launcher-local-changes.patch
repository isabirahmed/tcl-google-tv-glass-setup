+    private static List<String> pickAt(List<File> all, Map<String, Set<String>> groups, int hour, int minute) {
+        return names(WallpaperMood.pick(all, groups, hour * 60 + minute, RISE, SET));
+    }
+
+    @Test
+    public void dayAndSunsetGroupsFollowTheSun() {
+        List<File> all = files("d1.jpg", "d2.jpg", "s1.jpg", "n1.jpg", "n2.jpg");
+        Map<String, Set<String>> groups = new HashMap<>();
+        groups.put(WallpaperMood.DAY, new HashSet<>(Arrays.asList("d1.jpg", "d2.jpg")));
+        groups.put(WallpaperMood.SUNSET, new HashSet<>(Collections.singletonList("s1.jpg")));
+        groups.put(WallpaperMood.NIGHT, new HashSet<>(Arrays.asList("n1.jpg", "n2.jpg")));
+        List<String> day = Arrays.asList("d1.jpg", "d2.jpg"), sunset = Collections.singletonList("s1.jpg"),
+                night = Arrays.asList("n1.jpg", "n2.jpg");
+        assertEquals(night, pickAt(all, groups, 5, 0));
+        assertEquals(night, pickAt(all, groups, 7, 19));
+        assertEquals(day, pickAt(all, groups, 7, 20));        // sunrise
+        assertEquals(day, pickAt(all, groups, 12, 0));         // the afternoon is day too, not evening
+        assertEquals(day, pickAt(all, groups, 17, 34));
+        assertEquals(sunset, pickAt(all, groups, 17, 35));     // three quarters of an hour before sunset
+        assertEquals(sunset, pickAt(all, groups, 18, 20));     // sunset
+        assertEquals(sunset, pickAt(all, groups, 18, 49));     // half an hour after
+        assertEquals(night, pickAt(all, groups, 18, 50));
+        assertEquals(night, pickAt(all, groups, 23, 59));
+    }
+
+    @Test
+    public void aMissingGroupFallsBackToTheNextOneThatFits() {
+        List<File> all = files("a.jpg", "b.jpg", "c.jpg");
+        Map<String, Set<String>> old = new HashMap<>();   // a collection written before day and sunset existed
+        old.put(WallpaperMood.MORNING, new HashSet<>(Collections.singletonList("a.jpg")));
+        old.put(WallpaperMood.EVENING, new HashSet<>(Collections.singletonList("b.jpg")));
+        old.put(WallpaperMood.NIGHT, new HashSet<>(Collections.singletonList("c.jpg")));
+        assertEquals(Collections.singletonList("a.jpg"), pickAt(all, old, 9, 0));
+        assertEquals(Collections.singletonList("b.jpg"), pickAt(all, old, 15, 0));
+        assertEquals(Collections.singletonList("b.jpg"), pickAt(all, old, 18, 0));   // the golden hour was evening
+        assertEquals(Collections.singletonList("c.jpg"), pickAt(all, old, 22, 0));
+        // no sunset or evening group, but a day group: the golden hour shows day
+        Map<String, Set<String>> dayOnly = new HashMap<>();
+        dayOnly.put(WallpaperMood.DAY, new HashSet<>(Collections.singletonList("a.jpg")));
+        assertEquals(Collections.singletonList("a.jpg"), pickAt(all, dayOnly, 18, 0));
+        assertEquals(names(all), pickAt(all, dayOnly, 22, 0));                       // no night group: everything
+        assertEquals(names(all), pickAt(all, Collections.emptyMap(), 9, 0));
+    }
