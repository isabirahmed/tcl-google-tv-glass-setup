diff --git a/launcher/app/src/main/res/drawable/pill_glass.xml b/launcher/app/src/main/res/drawable/pill_glass.xml
new file mode 100644
index 00000000..40c16fae
--- /dev/null
+++ b/launcher/app/src/main/res/drawable/pill_glass.xml
@@ -0,0 +1,17 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- The weather and air quality pill under the date: smoky glass over the blurred wallpaper (GlassBackdrop paints the blur
+     underneath), like the cards: a dark veil and a faint light, no edge line. Flat. -->
+<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
+    <item>
+        <shape android:shape="rectangle">
+            <solid android:color="#59000000" />
+            <corners android:radius="40dp" />
+        </shape>
+    </item>
+    <item>
+        <shape android:shape="rectangle">
+            <gradient android:angle="315" android:startColor="#1CFFFFFF" android:endColor="#08FFFFFF" />
+            <corners android:radius="40dp" />
+        </shape>
+    </item>
+</layer-list>
