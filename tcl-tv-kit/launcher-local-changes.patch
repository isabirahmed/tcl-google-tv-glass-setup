+        canvas.save();
+        canvas.translate(b.left, b.top);
+        rect.set(0, 0, b.width(), b.height());
+        fill.setAlpha(level);
+        sheen.setAlpha(level);
+        canvas.drawRoundRect(rect, r, r, fill);
+        canvas.drawRoundRect(rect, r, r, sheen);
+        rect.inset(rimWidth / 2f, rimWidth / 2f);
